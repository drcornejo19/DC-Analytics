# Número internacional sin espacios ni símbolos. Ejemplo: 5491112345678
WHATSAPP_NUMBER=WHATSAPP_NUMBER

# Email que recibirá las consultas del formulario
CONTACT_EMAIL=CONTACT_EMAIL

# Clave privada creada en Resend. Nunca usar NEXT_PUBLIC_ en esta variable.
RESEND_API_KEY=RESEND_API_KEY

# URL pública final, sin barra al final. Ejemplo: https://dcanalytics.com
NEXT_PUBLIC_SITE_URL=NEXT_PUBLIC_SITE_URL
